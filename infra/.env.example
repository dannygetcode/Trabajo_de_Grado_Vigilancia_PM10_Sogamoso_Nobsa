# Copia este archivo a infra/.env para cambiar los valores por defecto del compose.
# Todo lo de aquí es de DESARROLLO: no uses estas contraseñas en la nube.

# Contraseña del usuario svca de PostgreSQL local.
SVCA_BD_CONTRASENA=desarrollo

# Puerto del host para PostgreSQL (cámbialo si ya tienes uno en el 5432).
SVCA_PUERTO_BD=5432

# Orígenes que las APIs aceptan por CORS (la web local).
SVCA_ORIGENES=http://localhost:8080

# Carpeta del host con data/processed/historico_normalizado.csv (ruta absoluta o relativa a infra/).
# Sin definir, se monta infra/vacio y el simulador arranca sin histórico.
# SIM_HISTORICO_DIR=../data/processed
